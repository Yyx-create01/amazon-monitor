# 飞书 App 凭证
FEISHU_APP_ID=cli_你的AppId
FEISHU_APP_SECRET=你的AppSecret

# 源表格 — 监控列表
FEISHU_SOURCE_SHEET_TOKEN=源表格Token
FEISHU_SOURCE_SHEET_ID=0

# 结果表格 — 变化日志
FEISHU_RESULT_SHEET_TOKEN=结果表格Token
FEISHU_RESULT_SHEET_ID=0

# 飞书通知 Chat ID
FEISHU_CHAT_ID=oc_你的ChatId

# 卖家精灵 MCP
SELLERSPRITE_SECRET_KEY=你的MCP密钥

# 以下可选：限流时自动触发 GitHub Actions（US IP 备份）
# GITHUB_REPO=你的账号/仓库名
# GITHUB_DISPATCH_TOKEN=ghp_你的Token
